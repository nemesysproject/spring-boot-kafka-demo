# ==============================================================================
# VARIABLES DE AMBIENTE - SPRING KAFKA DEMO (EJEMPLO)
# Copia este archivo a .env y define tus credenciales seguras.
# ==============================================================================

# Credenciales de Base de Datos PostgreSQL
POSTGRES_DB=notification_db
POSTGRES_USER=demo_user
POSTGRES_PASSWORD=demo_password
POSTGRES_PORT=5433

# Configuración de Conexión Spring Boot DataSource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/notification_db
SPRING_DATASOURCE_USERNAME=demo_user
SPRING_DATASOURCE_PASSWORD=demo_password

# Configuración de Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_NOTIFICATIONS=notification-events

# Configuración del Reverse Proxy Nginx
NGINX_PORT=80

